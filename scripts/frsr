#!/usr/bin/env bash
#
# frsr — run an fr-security-review audit on Codex or OpenCode from any directory.
#
# Installed to a PATH dir by `make install-launchers`, which bakes the repo root
# into @@REPO@@ below. It sets the per-harness FR_SECURITY_CORE_ROOT (and, for
# OpenCode, OPENCODE_CONFIG), resolves the model tier map, and invokes the harness
# — removing the manual export dance.
#
# Usage:
#   frsr <project|changes> --harness <codex|opencode> [options] [-- extra args]
#
# Options:
#   --harness <codex|opencode>   required
#   --review-root <dir>          output dir (default: security-review-<harness> in cwd)
#   --project-root <dir>         project to audit (default: current dir)
#   --models high=<id>,fast=<id> pin model tiers (bypasses auto-proposal)
#   --no-resolve                 reuse an existing .model_map.json, skip discovery
#   --go                         (codex) actually execute; without it, the prepared
#                                command is printed for review (codex runs the
#                                orchestrator UNSANDBOXED to spawn workers)
#   --dry-run                    print what would run, do nothing
#
# Everything after `--` is appended verbatim to the orchestrator arguments
# (e.g. -- --no-console --quick).
#
set -euo pipefail

REPO="@@REPO@@"

die() { echo "frsr: $*" >&2; exit 2; }
usage() { sed -n '3,27p' "$0" | sed 's/^# \{0,1\}//'; }

[ $# -ge 1 ] || { usage; exit 2; }
SUB="$1"; shift
case "$SUB" in
  project|changes) ;;
  -h|--help|help) usage; exit 0 ;;
  *) die "unknown subcommand '$SUB' (want: project|changes)" ;;
esac

HARNESS="" ; REVIEW_ROOT="" ; PROJECT_ROOT="$PWD" ; MODELS="" ; RESOLVE=1 ; GO=0 ; DRY=0
PASS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --harness) HARNESS="${2:?}"; shift 2 ;;
    --harness=*) HARNESS="${1#*=}"; shift ;;
    --review-root) REVIEW_ROOT="${2:?}"; shift 2 ;;
    --review-root=*) REVIEW_ROOT="${1#*=}"; shift ;;
    --project-root) PROJECT_ROOT="${2:?}"; shift 2 ;;
    --project-root=*) PROJECT_ROOT="${1#*=}"; shift ;;
    --models) MODELS="${2:?}"; shift 2 ;;
    --models=*) MODELS="${1#*=}"; shift ;;
    --no-resolve) RESOLVE=0; shift ;;
    --go|-y) GO=1; shift ;;
    --dry-run) DRY=1; shift ;;
    --) shift; PASS+=("$@"); break ;;
    *) PASS+=("$1"); shift ;;
  esac
done

case "$HARNESS" in
  codex)
    PLUGIN="$REPO/dist/codex/plugins/fr-security-review"
    CORE="$PLUGIN/core"
    DISCOVERY="codex debug models"
    ;;
  opencode)
    CORE="$REPO/dist/opencode/core"
    DISCOVERY="opencode models"
    export OPENCODE_CONFIG="$REPO/dist/opencode/opencode.json"
    ;;
  "") die "--harness codex|opencode is required" ;;
  *) die "unknown harness '$HARNESS'" ;;
esac

[ -d "$CORE" ] || die "bundle not built at $CORE — run 'make install-$HARNESS' in $REPO"

export FR_SECURITY_CORE_ROOT="$CORE"
: "${REVIEW_ROOT:=security-review-$HARNESS}"
CMD="security-$SUB"

echo "frsr: harness=$HARNESS  project_root=$PROJECT_ROOT  review_root=$REVIEW_ROOT"
echo "frsr: FR_SECURITY_CORE_ROOT=$FR_SECURITY_CORE_ROOT"

# --- model tiers (idempotent; persisted to <review_root>/.model_map.json) ---
if [ "$RESOLVE" = 1 ]; then
  RESOLVE_CMD=(python3 "$CORE/bin/shared/model_resolver.py"
              --discovery-cmd "$DISCOVERY" --review-root "$REVIEW_ROOT")
  [ -n "$MODELS" ] && RESOLVE_CMD+=(--models "$MODELS")
  if [ "$DRY" = 1 ]; then echo "DRY: ${RESOLVE_CMD[*]}"; else "${RESOLVE_CMD[@]}"; fi
fi

ARGS="project_root=$PROJECT_ROOT review_root=$REVIEW_ROOT"
[ ${#PASS[@]} -gt 0 ] && ARGS="$ARGS ${PASS[*]}"

if [ "$HARNESS" = opencode ]; then
  RUN=(opencode run --command "$CMD" "$ARGS")
  if [ "$DRY" = 1 ]; then printf 'DRY: '; printf '%q ' "${RUN[@]}"; echo; exit 0; fi
  exec "${RUN[@]}"
else
  # Codex has no headless "invoke skill by name"; drive the installed SKILL by
  # path. The orchestrator must run UNSANDBOXED to spawn worker processes; the
  # workers it launches stay `-s workspace-write` sandboxed + offline.
  PROMPT="read and follow $PLUGIN/skills/$CMD/SKILL.md then run it: $ARGS"
  RUN=(codex exec --dangerously-bypass-approvals-and-sandbox "$PROMPT")
  if [ "$DRY" = 1 ] || [ "$GO" != 1 ]; then
    echo
    echo "Prepared Codex command (orchestrator runs UNSANDBOXED to spawn workers;"
    echo "the workers it spawns stay sandboxed + offline). Review, then add --go to run:"
    echo
    printf '  '; printf '%q ' "${RUN[@]}"; echo
    exit 0
  fi
  exec "${RUN[@]}"
fi
