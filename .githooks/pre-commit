#!/usr/bin/env bash
set -euo pipefail

echo "Running plugin validation..."

if ! command -v claude &>/dev/null; then
  echo "ERROR: 'claude' CLI not found. Install Claude Code to validate plugins."
  exit 1
fi

claude plugin validate .

echo "Plugin validation passed."

# Multi-environment build gate (fast): byte-identity of the Claude artifacts +
# the build test suite. The slow ~1130-test engine suite stays manual / CI.
if ! command -v python3 &>/dev/null; then
  echo "ERROR: 'python3' not found. Install Python 3 to run the build gate."
  exit 1
fi

echo "Running build byte-identity check..."
python3 build/build.py --harness=claude --mode=check

echo "Running Codex derivation structural gates..."
python3 build/build.py --harness=codex --mode=check

echo "Running build test suite..."
python3 -m unittest discover -s build/tests

echo "Build gate passed."
