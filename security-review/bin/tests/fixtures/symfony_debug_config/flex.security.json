{
    "security": {
        "password_hashers": {
            "Symfony\\Component\\Security\\Core\\User\\PasswordAuthenticatedUserInterface": {
                "algorithm": "auto",
                "migrate_from": [],
                "hash_algorithm": "sha512",
                "key_length": 40,
                "ignore_case": false,
                "encode_as_base64": true,
                "iterations": 5000,
                "cost": null,
                "memory_cost": null,
                "time_cost": null
            }
        },
        "providers": {
            "app_user_provider": {
                "entity": {
                    "class": "App\\Entity\\User",
                    "property": "email",
                    "manager_name": null
                }
            }
        },
        "firewalls": {
            "dev": {
                "pattern": "^/(_profiler|_wdt|assets|build)/",
                "security": false,
                "methods": [],
                "user_checker": "security.user_checker",
                "stateless": false,
                "lazy": false,
                "required_badges": []
            },
            "main": {
                "lazy": true,
                "provider": "app_user_provider",
                "stateless": false,
                "context": "shared_ctx",
                "form_login": {
                    "login_path": "app_login",
                    "check_path": "app_login",
                    "csrf_token_id": "authenticate",
                    "password_parameter": "_pass",
                    "remember_me": true,
                    "use_forward": false,
                    "username_parameter": "_username",
                    "csrf_parameter": "_csrf_token",
                    "enable_csrf": false,
                    "post_only": true,
                    "form_only": false,
                    "always_use_default_target_path": false,
                    "default_target_path": "/",
                    "target_path_parameter": "_target_path",
                    "use_referer": false,
                    "failure_path": null,
                    "failure_forward": false,
                    "failure_path_parameter": "_failure_path"
                },
                "login_throttling": {
                    "max_attempts": 3,
                    "interval": "1 minute",
                    "lock_factory": "auto",
                    "cache_pool": "cache.rate_limiter",
                    "storage_service": null
                },
                "remember_me": {
                    "secret": "s3cr3t",
                    "lifetime": 604800,
                    "user_providers": [],
                    "catch_exceptions": true,
                    "signature_properties": [],
                    "name": "REMEMBERME",
                    "path": "/",
                    "domain": null,
                    "secure": "auto",
                    "httponly": true,
                    "samesite": "lax",
                    "always_remember_me": false,
                    "remember_me_parameter": "_remember_me"
                },
                "logout": {
                    "enable_csrf": null,
                    "csrf_token_id": "logout",
                    "csrf_parameter": "_csrf_token",
                    "path": "/logout",
                    "target": "/",
                    "invalidate_session": true,
                    "clear_site_data": [],
                    "delete_cookies": []
                },
                "switch_user": {
                    "parameter": "_switch_user",
                    "role": "ROLE_ALLOWED_TO_SWITCH",
                    "target_route": null
                },
                "methods": [],
                "security": true,
                "user_checker": "security.user_checker",
                "required_badges": []
            }
        },
        "access_control": [
            {
                "path": "^/admin",
                "roles": [
                    "ROLE_ADMIN"
                ],
                "request_matcher": null,
                "requires_channel": null,
                "host": null,
                "port": null,
                "ips": [],
                "attributes": [],
                "route": null,
                "methods": [],
                "allow_if": null
            },
            {
                "path": "^/profile",
                "roles": [
                    "ROLE_USER",
                    "ROLE_EDITOR"
                ],
                "methods": [
                    "GET",
                    "POST"
                ],
                "request_matcher": null,
                "requires_channel": null,
                "host": null,
                "port": null,
                "ips": [],
                "attributes": [],
                "route": null,
                "allow_if": null
            },
            {
                "path": "^/internal",
                "roles": [
                    "PUBLIC_ACCESS"
                ],
                "ips": [
                    "127.0.0.1",
                    "::1"
                ],
                "request_matcher": null,
                "requires_channel": null,
                "host": null,
                "port": null,
                "attributes": [],
                "route": null,
                "methods": [],
                "allow_if": null
            }
        ],
        "access_denied_url": null,
        "session_fixation_strategy": "migrate",
        "expose_security_errors": "none",
        "erase_credentials": true,
        "access_decision_manager": {
            "allow_if_all_abstain": false,
            "allow_if_equal_granted_denied": true
        },
        "role_hierarchy": []
    }
}
