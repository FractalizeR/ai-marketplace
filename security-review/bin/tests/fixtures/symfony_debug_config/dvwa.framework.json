{
    "framework": {
        "cache": {
            "prefix_seed": "_/app.App_KernelDevDebugContainer",
            "app": "cache.adapter.filesystem",
            "system": "cache.adapter.system",
            "directory": "/app/var/share/dev/pools/app",
            "default_redis_provider": "redis://localhost",
            "default_valkey_provider": "valkey://localhost",
            "default_memcached_provider": "memcached://localhost",
            "default_doctrine_dbal_provider": "database_connection",
            "default_pdo_provider": null,
            "pools": []
        },
        "secret": "%env(APP_SECRET)%",
        "session": {
            "enabled": true,
            "storage_factory_id": "session.storage.factory.native",
            "cookie_secure": "auto",
            "cookie_httponly": true,
            "cookie_samesite": "lax",
            "metadata_update_threshold": 0
        },
        "lock": {
            "resources": {
                "default": [
                    "%env(LOCK_DSN)%"
                ]
            },
            "enabled": true
        },
        "messenger": {
            "transports": {
                "async": {
                    "dsn": "doctrine://default",
                    "serializer": "messenger.transport.native_php_serializer",
                    "options": [],
                    "failure_transport": null,
                    "retry_strategy": {
                        "service": null,
                        "max_retries": 3,
                        "delay": 1000,
                        "multiplier": 2,
                        "max_delay": 0,
                        "jitter": 0.1
                    },
                    "rate_limiter": null
                }
            },
            "routing": {
                "App\\Message\\ProcessOrder": [
                    "async"
                ]
            },
            "enabled": true,
            "serializer": {
                "default_serializer": "messenger.transport.native_php_serializer",
                "symfony_serializer": {
                    "format": "json",
                    "context": []
                }
            },
            "failure_transport": null,
            "stop_worker_on_signals": [],
            "default_bus": null,
            "buses": {
                "messenger.bus.default": {
                    "default_middleware": {
                        "enabled": true,
                        "allow_no_handlers": false,
                        "allow_no_senders": true
                    },
                    "middleware": []
                }
            }
        },
        "property_info": {
            "with_constructor_extractor": true,
            "enabled": true
        },
        "router": {
            "default_uri": "%env(DEFAULT_URI)%",
            "enabled": true,
            "resource": "kernel::loadRoutes",
            "type": "service",
            "http_port": 80,
            "https_port": 443,
            "strict_requirements": true,
            "utf8": true
        },
        "http_method_override": false,
        "allowed_http_method_override": null,
        "trust_x_sendfile_type_header": "%env(bool:default::SYMFONY_TRUST_X_SENDFILE_TYPE_HEADER)%",
        "ide": "%env(default::SYMFONY_IDE)%",
        "default_locale": "en",
        "set_locale_from_accept_language": false,
        "set_content_language_from_locale": false,
        "enabled_locales": [],
        "trusted_hosts": [
            "%env(default::SYMFONY_TRUSTED_HOSTS)%"
        ],
        "trusted_proxies": [
            "%env(default::SYMFONY_TRUSTED_PROXIES)%"
        ],
        "trusted_headers": [
            "%env(default::SYMFONY_TRUSTED_HEADERS)%"
        ],
        "error_controller": "error_controller",
        "handle_all_throwables": true,
        "csrf_protection": {
            "enabled": null,
            "stateless_token_ids": [],
            "check_header": false,
            "cookie_name": "csrf-token"
        },
        "form": {
            "enabled": false,
            "csrf_protection": {
                "enabled": null,
                "token_id": null,
                "field_name": "_token",
                "field_attr": {
                    "data-controller": "csrf-protection"
                }
            }
        },
        "http_cache": {
            "enabled": false,
            "debug": true,
            "private_headers": [],
            "skip_response_headers": []
        },
        "esi": {
            "enabled": false
        },
        "ssi": {
            "enabled": false
        },
        "fragments": {
            "enabled": false,
            "hinclude_default_template": null,
            "path": "/_fragment"
        },
        "profiler": {
            "enabled": false,
            "collect": true,
            "collect_parameter": null,
            "only_exceptions": false,
            "only_main_requests": false,
            "dsn": "file:/app/var/cache/dev/profiler",
            "collect_serializer_data": true
        },
        "workflows": {
            "enabled": false,
            "workflows": []
        },
        "request": {
            "enabled": false,
            "formats": []
        },
        "assets": {
            "enabled": false,
            "strict_mode": false,
            "version_strategy": null,
            "version": null,
            "version_format": "%%s?%%s",
            "json_manifest_path": null,
            "base_path": "",
            "base_urls": [],
            "packages": []
        },
        "asset_mapper": {
            "enabled": false,
            "paths": [],
            "excluded_patterns": [],
            "exclude_dotfiles": true,
            "server": true,
            "public_prefix": "/assets/",
            "missing_import_mode": "warn",
            "extensions": [],
            "importmap_path": "/app/importmap.php",
            "importmap_polyfill": "es-module-shims",
            "importmap_script_attributes": [],
            "vendor_dir": "/app/assets/vendor",
            "precompress": {
                "enabled": false,
                "formats": [],
                "extensions": []
            }
        },
        "translator": {
            "enabled": false,
            "fallbacks": [],
            "logging": false,
            "formatter": "translator.formatter.default",
            "cache_dir": "/app/var/cache/dev/translations",
            "default_path": "/app/translations",
            "paths": [],
            "pseudo_localization": {
                "enabled": false,
                "accents": true,
                "expansion_factor": 1,
                "brackets": true,
                "parse_html": false,
                "localizable_html_attributes": []
            },
            "providers": [],
            "globals": []
        },
        "validation": {
            "enabled": false,
            "enable_attributes": true,
            "static_method": [
                "loadValidatorMetadata"
            ],
            "translation_domain": "validators",
            "email_validation_mode": "html5",
            "mapping": {
                "paths": []
            },
            "not_compromised_password": {
                "enabled": true,
                "endpoint": null
            },
            "disable_translation": false,
            "property_metadata_existence_check": false,
            "auto_mapping": []
        },
        "serializer": {
            "enabled": false,
            "enable_attributes": true,
            "mapping": {
                "paths": []
            },
            "default_context": [],
            "named_serializers": []
        },
        "property_access": {
            "enabled": true,
            "magic_call": false,
            "magic_get": true,
            "magic_set": true,
            "throw_exception_on_invalid_index": false,
            "throw_exception_on_invalid_property_path": true
        },
        "type_info": {
            "enabled": true,
            "aliases": []
        },
        "php_errors": {
            "log": true,
            "throw": true
        },
        "exceptions": [],
        "web_link": {
            "enabled": false
        },
        "semaphore": {
            "enabled": false,
            "resources": []
        },
        "scheduler": {
            "enabled": false
        },
        "disallow_search_engine_index": true,
        "http_client": {
            "enabled": false,
            "scoped_clients": []
        },
        "mailer": {
            "enabled": false,
            "message_bus": null,
            "dsn": null,
            "transports": [],
            "headers": [],
            "dkim_signer": {
                "enabled": false,
                "key": "",
                "domain": "",
                "select": "",
                "passphrase": "",
                "options": []
            },
            "smime_signer": {
                "enabled": false,
                "key": "",
                "certificate": "",
                "passphrase": null,
                "extra_certificates": null,
                "sign_options": null
            },
            "smime_encrypter": {
                "enabled": false,
                "repository": "",
                "cipher": null
            }
        },
        "secrets": {
            "enabled": true,
            "vault_directory": "/app/config/secrets/%env(default:kernel.environment:APP_RUNTIME_ENV)%",
            "local_dotenv_file": "/app/.env.dev.local",
            "decryption_env_var": "base64:default::SYMFONY_DECRYPTION_SECRET"
        },
        "notifier": {
            "enabled": false,
            "message_bus": null,
            "chatter_transports": [],
            "texter_transports": [],
            "notification_on_failed_messages": false,
            "channel_policy": [],
            "admin_recipients": []
        },
        "rate_limiter": {
            "enabled": true,
            "limiters": []
        },
        "uid": {
            "enabled": false,
            "default_uuid_version": 7,
            "name_based_uuid_version": 5,
            "time_based_uuid_version": 7,
            "uuid47_secret": null
        },
        "html_sanitizer": {
            "enabled": false,
            "sanitizers": []
        },
        "webhook": {
            "enabled": false,
            "message_bus": "messenger.default_bus",
            "event_header_name": "Webhook-Event",
            "id_header_name": "Webhook-Id",
            "signature_header_name": "Webhook-Signature",
            "signing_algorithm": "sha256",
            "routing": []
        },
        "remote_event": {
            "enabled": false
        },
        "json_streamer": {
            "enabled": false,
            "default_options": {
                "include_null_properties": false
            }
        }
    }
}
