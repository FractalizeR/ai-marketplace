{
    "twig": {
        "file_name_pattern": [
            "*.twig"
        ],
        "form_themes": [
            "form_div_layout.html.twig"
        ],
        "globals": [],
        "autoescape_service": null,
        "autoescape_service_method": null,
        "cache": true,
        "charset": "UTF-8",
        "debug": true,
        "strict_variables": true,
        "default_path": "/app/templates",
        "paths": [],
        "date": {
            "format": "F j, Y H:i",
            "interval_format": "%d days",
            "timezone": null
        },
        "number_format": {
            "decimals": 0,
            "decimal_point": ".",
            "thousands_separator": ","
        }
    }
}
